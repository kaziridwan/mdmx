{
  "name": "@mdmx/editor",
  "version": "0.7.0",
  "description": "Block editor (ProseMirror) with registry-driven component nodes, React NodeViews, and prop panels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaziridwan/mdmx.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/kaziridwan/mdmx#readme",
  "bugs": {
    "url": "https://github.com/kaziridwan/mdmx/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "~6.11.0",
    "@codemirror/lang-javascript": "~6.2.5",
    "@codemirror/lang-markdown": "~6.5.2",
    "@codemirror/language": "~6.12.4",
    "@codemirror/lint": "~6.9.7",
    "@codemirror/state": "~6.7.2",
    "@codemirror/view": "~6.43.10",
    "@lezer/highlight": "~1.2.3",
    "@mdmx/core": "workspace:*",
    "prosemirror-commands": "~1.7.1",
    "prosemirror-dropcursor": "~1.8.1",
    "prosemirror-gapcursor": "~1.3.2",
    "prosemirror-history": "~1.4.1",
    "prosemirror-inputrules": "~1.5.0",
    "prosemirror-keymap": "~1.2.3",
    "prosemirror-model": "~1.25.4",
    "prosemirror-state": "~1.4.3",
    "prosemirror-transform": "~1.10.4",
    "prosemirror-view": "~1.40.1"
  },
  "devDependencies": {
    "@types/mdast": "~4.0.4",
    "@types/node": "~22.10.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "~25.0.1",
    "mdast-util-mdx-jsx": "~3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "files": [
    "dist"
  ]
}
