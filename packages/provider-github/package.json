{
  "name": "@mdmx/provider-github",
  "version": "0.5.0",
  "description": "ContentProvider implementation over the GitHub Git Data API (atomic multi-file commits)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdmx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~22.10.10"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
