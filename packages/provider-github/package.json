  "description": "ContentProvider implementation over the GitHub Git Data API (atomic multi-file commits)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaziridwan/mdmx.git",
    "directory": "packages/provider-github"
  },
  "homepage": "https://github.com/kaziridwan/mdmx#readme",
